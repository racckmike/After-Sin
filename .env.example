# Copy to .env.local and fill in real values from your Vercel/Neon dashboard.
# Never commit .env.local — only this file (names + placeholders) is tracked.

# Postgres connection (Neon, via the Vercel Storage integration).
# Used by the waitlist and by customer profile/address tables.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Neon Auth (Better Auth, managed) — provisioned automatically alongside
# the database above. Find these in the Neon console's "Auth" tab, or in
# Vercel > Project > Environment Variables once the integration is connected.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-2.region.aws.neon.tech/dbname/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxxx.neonauth.c-2.region.aws.neon.tech/dbname/auth"

# Generate your own with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-32+-character-secret"
