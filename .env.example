# Copy to .env.local and fill in real values from your Vercel/Neon dashboard.
# Never commit .env.local — only this file (names + placeholders) is tracked.

# Postgres connection (Neon, via the Vercel Storage integration).
# Used by the waitlist and by customer profile/address tables.
DATABASE_URL="postgres://user:password@host/dbname?sslmode=require"

# Neon Auth (Better Auth, managed) — provisioned automatically alongside
# the database above. Find these in the Neon console's "Auth" tab, or in
# Vercel > Project > Environment Variables once the integration is connected.
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-2.region.aws.neon.tech/dbname/auth"
NEXT_PUBLIC_NEON_AUTH_URL="https://ep-xxxx.neonauth.c-2.region.aws.neon.tech/dbname/auth"

# Generate your own with: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-a-random-32+-character-secret"

# Resend (branded transactional email — password reset, etc.). Neon Auth has
# no dashboard email-template editor yet, so app/api/webhooks/neon-auth
# sends these itself when Neon's send.magic_link webhook fires. Get an API
# key at https://resend.com/api-keys after verifying a sending domain.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Must be on a domain verified in Resend, e.g. "AFTER SIN <auth@aftersin.shop>".
# Falls back to Resend's shared test address if unset (works, but everyone
# sees it's from Resend, not AFTER SIN).
RESEND_FROM_ADDRESS="AFTER SIN <auth@aftersin.shop>"

# Mercado Pago Checkout Pro (checkout/payments). Get TEST- credentials from
# "Your integrations" > your app > "Test credentials" in the Mercado Pago
# developer dashboard. NEVER use TEST- and production credentials in the
# same environment at once.
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000"

# From the same app's "Webhooks > Configure notifications" page — a
# separate secret from the access token, used to verify that a webhook
# request really came from Mercado Pago. See app/api/webhooks/mercadopago.
MERCADOPAGO_WEBHOOK_SECRET="replace-with-the-webhook-secret-key"

# Used to build Mercado Pago's back_urls/notification_url — must be a real
# HTTPS origin for the payment webhook to reach this app (Mercado Pago
# rejects localhost). Falls back to the request's own origin when unset,
# which is fine for back_urls but not for the webhook in local dev — see
# the checkout section of the final report.
NEXT_PUBLIC_SITE_URL="https://www.aftersin.shop"
